# -------------------------------------------------------------
# TiddlyWiki MWS: Wiki Editions & Data
# -------------------------------------------------------------
# 1) Keep 'www' subdomain in version control (ignore everything else).
#   - The ! syntax inverts ignore for www
wikis/*
!wikis/www/

# -------------------------------------------------------------
# TiddlyWiki MWS Data
# -------------------------------------------------------------
# Ignore all data directories so local SQLite DB, attachments, etc. are not committed
data/
